# Makefile.win — Windows port of wubuwizard (MSYS2 gcc 16 + CUDA 12.4 nvcc).
#
# CPU-only first (proves the port compiles+links); CUDA/sm_75 target is phase 2.
# POSIX surface is covered by include/wubu_win.h (force-included) + include/win32 stubs.
# AVX-512 is disabled (Ryzen 5 3600 has no AVX-512) via WUBU_NO_AVX512; the
# engine's AVX-512 paths are runtime-dispatched and gated behind that macro.
# SPDX-License-Identifier: WaefreBeorn-UMV3

CC      = gcc
CXX     = g++
NVCC    = nvcc
CUDA_DIR = C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4
CUDA_INC = -I"$(CUDA_DIR)/include"
CUDA_LIB  = "$(CUDA_DIR)/lib/x64"

CFLAGS  = -O2 -std=c11 -ffast-math -funroll-loops -ftree-vectorize \
          -mavx2 -mfma -mavx -mf16c -DWUBU_NO_AVX512 -D_USE_MATH_DEFINES \
          -fopenmp -Wall -Wextra -Wno-unused-parameter \
          -I include -I include/win32 -DWUBU_BUILD_WIN -include wubu_win.h
NVCCFLAGS = -O2 -std=c++17 -I include -DWUBU_BUILD_WIN -arch=sm_75 \
            $(CUDA_INC) -Xcompiler "-fopenmp"

LDLIBS  = -L$(CUDA_LIB) -lcudart -lcublas \
          -lws2_32 -ladvapi32 -lkernel32 -luser32 \
          -fopenmp -lm

CORE_OBJ = src/wubu_model.o src/wubu_dims.o src/wubu_dims_gpu_stub.o src/wubu_ssm.o \
  src/wubu_ssm_workspace.o src/wubu_ssm_chunked.o src/wubu_mobius.o \
  src/wubu_nested_ssm.o src/wubu_nested_ssm_backward.o src/wubu_moe.o \
  src/wubu_moe_backward.o src/wubu_moe_hyperbolic.o src/wubu_poincare_ssm_backward.o \
  src/wubu_poincare_gqa.o src/wubu_poincare_gqa_backward.o src/wubu_mobius_linear.o \
  src/wubu_hyperbolic_output_proj.o src/wubu_vision.o src/gguf_reader.o \
  src/qlearner.o src/rsgd.o src/wubu_tst.o src/dequant_iq2_xxs.o \
  src/quantized_matmul.o src/quantized_dot_generic.o src/safetensors_reader.o \
  src/wubu_repetition.o src/wubu_lora.o src/wubu_model_adapter.o \
  src/wubu_model_safetensors_bridge.o src/wubu_safetensors_shard.o \
  src/wubu_ssd_moe.o src/wubu_gemm.o src/wubu_kvcache_quant.o src/wubu_ssm_scan.o \
  src/wubu_roofline.o src/wubu_kv_select.o src/wubu_kv_runtime.o src/wubu_gemv_tune.o \
  src/wubu_affinity.o src/wubu_rotate.o src/wubu_flashdecode.o src/wubu_kvvq.o \
  src/wubu_spec_decode.o src/wubu_generate.o src/wubu_ternary.o src/wubu_smoothquant.o \
  src/wubu_arena.o src/wubu_mem_budget.o src/wubu_prefix_cache.o src/wubu_paged_kv.o \
  src/wubu_q4k_m.o src/wubu_delta_net.o src/wubu_scheduler.o src/wubu_ngram.o \
  src/wubu_self_cascade.o src/wubu_spec_cascade.o src/wubu_spawn.o src/wubu_spawn_win.o \
  src/wubu_kv_styx.o src/wubu_kv_tier.o src/wubu_attn_gate.o src/wubu_layer_skip.o \
  src/wubu_kv_adaptive.o src/wubu_awq.o src/wubu_gptq.o src/wubu_soa.o \
  src/wubu_flash_prefill.o src/wubu_kv_cacheline.o src/wubu_rope_prefetch.o \
  src/wubu_numerical_audit.o src/wubu_mla.o src/wubu_expert_choice.o \
  src/wubu_chunked_prefill.o src/wubu_smt_check.o src/wubu_lmcache.o src/wubu_kernel.o \
  src/wubu_kernel_backends.o src/wubu_fast_attn.o src/wubu_4kv.o src/wubu_polarquant.o \
  src/wubu_eagle.o src/wubu_kv_evict.o src/wubu_thread_spec.o src/wubu_early_exit.o \
  src/wubu_hwcaps.o src/wubu_tandem.o src/wubu_rambus.o src/wubu_gamebud.o src/wubu_fp8.o \
  src/wubu_ecs.o src/wubu_nvfp4.o src/wubu_hadamard.o src/wubu_expert_allreduce.o \
  src/wubu_dequant_fp4.o \
  src/wubu_equiv_check.o src/wubu_integrate.o src/wubu_capzero.o src/wubu_latency.o \
  src/wubu_ctxvm.o src/wubu_safekern.o src/wubu_loopguard.o src/wubu_planediv.o \
  src/wubu_coord.o src/wubu_metagame.o src/wubu_credit.o src/wubu_metagame2.o \
  src/wubu_resource.o src/wubu_worldmodel.o src/wubu_agentauth.o src/wubu_vecsearch.o \
  src/wubu_causal.o src/wubu_symbolic.o src/wubu_dgm.o src/wubu_tooluse.o src/wubu_synth.o \
  src/wubu_evolve.o src/wubu_codeexec.o src/wubu_sandbox_safekern.o src/wubu_codesynth.o \
  src/wubu_verify.o src/wubu_experibuf.o src/wubu_ewc.o src/wubu_taskbd.o src/wubu_distill.o \
  src/wubu_imgenc.o src/wubu_audio.o src/wubu_mm_align.o src/wubu_mm_adapter.o \
  src/wubu_mm_kv.o src/wubu_bft.o src/wubu_threshsig.o src/wubu_agentid.o src/wubu_semcons.o \
  src/wubu_fraud.o src/wubu_symreg.o src/wubu_sindy.o src/wubu_cegis.o src/wubu_prover.o \
  src/wubu_invariant.o src/wubu_gp.o src/wubu_acq.o src/wubu_bo.o src/wubu_uq.o \
  src/wubu_active.o src/wubu_bandit.o src/wubu_reinforce.o src/wubu_policy.o \
  src/wubu_actor_critic.o src/wubu_ppo.o src/wubu_dqn.o src/wubu_value.o src/wubu_specdec.o \
  src/wubu_pagedkv.o src/wubu_moeroute.o src/wubu_contbatch.o src/wubu_medusa.o src/wubu_quantkv.o \
  src/wubu_win.o

.PHONY: all cpu-build clean

all: gen_text_win

gen_text_win: tools/gen_text.c $(CORE_OBJ) src/wubu_tokenizer.o src/wubu_tokenizer_hf.o
	$(CC) $(CFLAGS) -o $@ tools/gen_text.c $(CORE_OBJ) src/wubu_tokenizer.o \
	  src/wubu_tokenizer_hf.o $(LDLIBS)
	@echo "gen_text_win built (CPU+shim, no CUDA kernels yet)"

src/wubu_tokenizer.o: src/wubu_tokenizer.c include/wubu_tokenizer.h
	$(CC) $(CFLAGS) -c -o $@ $<
src/wubu_tokenizer_hf.o: src/wubu_tokenizer_hf.c include/wubu_tokenizer_hf.h
	$(CC) $(CFLAGS) -c -o $@ $<

src/%.o: src/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

LFM2_OBJ = src/lfm2_math.o src/lfm2_conv.o src/lfm2_attn.o src/lfm2_ffn.o \
  src/lfm2_load.o src/lfm2_forward.o

lfm2_test: tools/lfm2_test.c $(CORE_OBJ) $(LFM2_OBJ) src/wubu_tokenizer.o src/wubu_tokenizer_hf.o
	$(CC) $(CFLAGS) -o $@ tools/lfm2_test.c $(LFM2_OBJ) $(CORE_OBJ) src/wubu_tokenizer.o src/wubu_tokenizer_hf.o $(LDLIBS)
	@echo "lfm2_test built"

lfm2_gen: tools/lfm2_gen.c $(CORE_OBJ) $(LFM2_OBJ) src/wubu_tokenizer.o src/wubu_tokenizer_hf.o
	$(CC) $(CFLAGS) -o $@ tools/lfm2_gen.c $(LFM2_OBJ) $(CORE_OBJ) src/wubu_tokenizer.o src/wubu_tokenizer_hf.o $(LDLIBS)
	@echo "lfm2_gen built"

clean:
	rm -f src/*.o gen_text_win lfm2_test lfm2_gen $(LFM2_OBJ)

ninja_required_version = 1.5
cc = gcc
cxx = g++
cflags = -O3 -march=native -ffast-math -funroll-loops -ftree-vectorize -Wall -Wextra -Wno-unused-parameter -I include -fopenmp

build src/wubu_model.o: cc src/wubu_model.c
  command = gcc -O3 -march=native -ffast-math -funroll-loops -ftree-vectorize -Wall -Wextra -Wno-unused-parameter -I include -I/usr/include -fopenmp   -c -o src/wubu_model.o src/wubu_model.c

build src/wubu_dims.o: cc src/wubu_dims.c
  command = gcc -O3 -march=native -ffast-math -funroll-loops -ftree-vectorize -Wall -Wextra -Wno-unused-parameter -I include -I/usr/include -fopenmp -c src/wubu_dims.c -o src/wubu_dims.o

build src/wubu_ssm.o: cc src/wubu_ssm.c
  command = gcc -O3 -march=native -ffast-math -funroll-loops -ftree-vectorize -Wall -Wextra -Wno-unused-parameter -I include -I/usr/include -fopenmp -DWUBU_ENABLE_CUDA -c -o src/wubu_ssm.o src/wubu_ssm.c

build src/wubu_ssm_workspace.o: cc src/wubu_ssm_workspace.c
